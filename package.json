{
  "name": "fragor",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Deterministic simulator for microservice resilience policies.",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc -p packages/engine && tsc -p packages/engine/test && tsc -p packages/scenarios && tsc -p packages/scenarios/test",
    "test": "vitest run",
    "bench": "vitest bench --run --silent=false"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
