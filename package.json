{
  "name": "fragor",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Deterministic simulator for microservice resilience policies.",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "bench": "pnpm -r --if-present run bench",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
